# Copy to .env.server in the project root (do not commit secrets).
# Google AI Studio / Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
# Optional — free-tier friendly defaults:
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MODEL=gemini-1.5-flash
# PORT=8787

# Optional: Supabase persistence (preferred for deployment).
# Use a server-side secret key (service_role or secret key), never the publishable key here.
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_SECRET_KEY="your_supabase_secret_key_here"
# SUPABASE_STORAGE_BUCKET="name_of_your_supabase_storage_bucket"
# REQUIRE_SUPABASE=true
